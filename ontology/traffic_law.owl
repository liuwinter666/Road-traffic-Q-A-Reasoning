<owl:NamedIndividual rdf:about="#V4_ND168-D13-K4-a">
  <rdf:type rdf:resource="#Diem"/>
  <thuocPhienBan rdf:resource="#V4"/>
  <thuocVanBan rdf:resource="#ND168"/>
  <thuocDieuKhoanCha rdf:resource="#V4_ND168-D13-K4"/>
