  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LTTATGT:LTTATGT-D59-K1-a — “Người đủ 16 tuổi trở lên được điều khiển xe gắn máy”</canCuPhapLy>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LXLVPHC:LXLVPHC-D5-K1-a — “người từ đủ 16 tuổi trở lên bị xử phạt vi phạm hành chính về mọi vi phạm hành chính”</canCuPhapLy>
</owl:Class>

<owl:Class rdf:about="#NguoiTu18TuoiTroLen">
  <rdfs:subClassOf rdf:resource="#NhomTuoi"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Nguoi"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#tuoi"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Người từ đủ 18 tuổi trở lên (được cấp GPLX hạng A1, A, B1, B, C1)</rdfs:label>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LTTATGT:LTTATGT-D59-K1-b — “Người đủ 18 tuổi trở lên được cấp giấy phép lái xe hạng A1, A, B1, B, C1”</canCuPhapLy>
</owl:Class>

