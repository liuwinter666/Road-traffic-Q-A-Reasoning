  <trichDan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">khoản 1 Điều 58 Luật GTĐB 2008</trichDan>
  <noiDung rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Người lái xe tham gia giao thông phải đủ độ tuổi, sức khoẻ quy định tại Điều 60 của Luật này và có giấy phép lái xe phù hợp với loại xe được phép điều khiển do cơ quan nhà nước có thẩm quyền cấp.
Người tập lái xe ô tô khi tham gia giao thông phải thực hành trên xe tập lái và có giáo viên bảo trợ tay lái.</noiDung>
  <trangThai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</trangThai>
  <hieuLucTu rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-07-01T00:00:00.000</hieuLucTu>
  <hieuLucDen rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-12-31T00:00:00.000</hieuLucDen>
  <rdfs:label xml:lang="vi">khoản 1 Điều 58 Luật GTĐB 2008</rdfs:label>
</owl:NamedIndividual>

