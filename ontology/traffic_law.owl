<owl:NamedIndividual rdf:about="#V3_ND168-D13-K4-a">
  <rdf:type rdf:resource="#Diem"/>
  <thuocPhienBan rdf:resource="#V3"/>
  <thuocVanBan rdf:resource="#ND168"/>
  <thuocDieuKhoanCha rdf:resource="#V3_ND168-D13-K4"/>
  <maDieuKhoan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ND168-D13-K4-a</maDieuKhoan>
  <trichDan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">điểm a khoản 4 Điều 13 NĐ 168/2024</trichDan>
  <noiDung rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều khiển xe không có chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) hoặc sử dụng chứng nhận đăng ký xe (hoặc bản sao chứng nhận đăng ký xe có chứng thực kèm theo bản gốc giấy biên nhận của tổ chức tín dụng, chi nhánh ngân hàng nước ngoài trong trường hợp tổ chức tín dụng, chi nhánh ngân hàng nước ngoài giữ bản gốc chứng nhận đăng ký xe) đã hết hạn sử dụng, hết hiệu lực (kể cả rơ moóc và sơ mi rơ moóc);</noiDung>
  <trangThai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</trangThai>
  <hieuLucTu rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-01-01T00:00:00.000</hieuLucTu>
  <hieuLucDen rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-08-14T00:00:00.000</hieuLucDen>
  <rdfs:label xml:lang="vi">V3 — điểm a khoản 4 Điều 13 NĐ 168/2024</rdfs:label>
</owl:NamedIndividual>

