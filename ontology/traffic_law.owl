  <noiDung rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nguyên tắc xử phạt vi phạm hành chính bao gồm:</noiDung>
  <trangThai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</trangThai>
