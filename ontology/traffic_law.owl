              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</xsd:minExclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Nồng độ cồn khí thở &gt; 0,4 mg/L</rdfs:label>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V1:ND100-D5-K10-a — “vượt quá 0,4 miligam/1 lít khí thở”</canCuPhapLy>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V3:ND168-D6-K11-a — “vượt quá 0,4 miligam/1 lít khí thở”</canCuPhapLy>
</owl:Class>

<owl:Class rdf:about="#NongDoConMauMuc1">
  <rdfs:subClassOf rdf:resource="#MucNongDoCon"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#HanhViDieuKhienXe"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#nongDoConMau"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <rdf:Description>
                          <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minExclusive>
                        </rdf:Description>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Nồng độ cồn trong máu &gt; 0 và ≤ 50 mg/100 mL</rdfs:label>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V1:ND100-D5-K6-c — “chưa vượt quá 50 miligam/100 mililít máu”</canCuPhapLy>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V3:ND168-D6-K6-c — “chưa vượt quá 50 miligam/100 mililít máu”</canCuPhapLy>
</owl:Class>

<owl:Class rdf:about="#NongDoConMauMuc2">
  <rdfs:subClassOf rdf:resource="#MucNongDoCon"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#HanhViDieuKhienXe"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#nongDoConMau"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">80</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <rdf:Description>
                          <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50</xsd:minExclusive>
                        </rdf:Description>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
