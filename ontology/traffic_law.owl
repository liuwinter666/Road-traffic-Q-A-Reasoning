</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LXLVPHC-D10-K2">
  <rdf:type rdf:resource="#Khoan"/>
  <thuocVanBan rdf:resource="#LXLVPHC"/>
  <thuocDieuKhoanCha rdf:resource="#LXLVPHC-D10"/>
  <maDieuKhoan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LXLVPHC-D10-K2</maDieuKhoan>
