              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</xsd:maxInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <rdf:Description>
                          <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.25</xsd:minExclusive>
                        </rdf:Description>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Nồng độ cồn khí thở &gt; 0,25 và ≤ 0,4 mg/L</rdfs:label>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V1:ND100-D5-K8-c — “vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở”</canCuPhapLy>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V3:ND168-D6-K9-a — “vượt quá 0,25 miligam đến 0,4 miligam/1 lít khí thở”</canCuPhapLy>
</owl:Class>

