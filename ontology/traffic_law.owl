        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label xml:lang="vi">Nồng độ cồn trong máu &gt; 0 và ≤ 50 mg/100 mL</rdfs:label>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V1:ND100-D5-K6-c — “chưa vượt quá 50 miligam/100 mililít máu”</canCuPhapLy>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V3:ND168-D6-K6-c — “chưa vượt quá 50 miligam/100 mililít máu”</canCuPhapLy>
</owl:Class>

