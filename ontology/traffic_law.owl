  <noiDung rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phạt tiền</noiDung>
  <trangThai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</trangThai>
  <hieuLucTu rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-07-01T00:00:00.000</hieuLucTu>
  <rdfs:label xml:lang="vi">Điều 23 LXLVPHC</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LXLVPHC-D23-K1">
  <rdf:type rdf:resource="#Khoan"/>
  <thuocVanBan rdf:resource="#LXLVPHC"/>
  <coKhungPhat rdf:resource="#KP_LXLVPHC-D23-K1"/>
  <coKhungPhat rdf:resource="#KP_TC_LXLVPHC-D23-K1"/>
  <thuocDieuKhoanCha rdf:resource="#LXLVPHC-D23"/>
  <maDieuKhoan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LXLVPHC-D23-K1</maDieuKhoan>
  <trichDan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">khoản 1 Điều 23 LXLVPHC</trichDan>
  <noiDung rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mức phạt tiền trong xử phạt vi phạm hành chính từ 50.000 đồng đến 1.000.000.000 đồng đối với cá nhân, từ 100.000 đồng đến 2.000.000.000 đồng đối với tổ chức, trừ trường hợp quy định tại khoản 3 Điều 24 của Luật này.
Đối với khu vực nội thành của thành phố thì mức phạt tiền có thể cao hơn, nhưng tối đa không quá 02 lần mức phạt chung áp dụng đối với cùng hành vi vi phạm trong các lĩnh vực giao thông đường bộ; bảo vệ môi trường; an ninh trật tự, an toàn xã hội.</noiDung>
  <trangThai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</trangThai>
  <hieuLucTu rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-01T00:00:00.000</hieuLucTu>
  <noiDungTruocDo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Không có trong dữ liệu — văn bản hợp nhất chỉ chứa câu chữ hiện hành; câu chữ áp dụng trước 2025-07-01 có thể khác.</noiDungTruocDo>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chú thích [27] văn bản hợp nhất: Cụm từ “trực thuộc trung ương” được bỏ theo quy định tại điểm a khoản 29 Điều 1 của Luật số 88/2025/QH15 sửa đổi, bổ sung một số điều của Luật Xử lý vi phạm hành chính, có hiệu lực kể từ ngày 01 tháng 7 năm 2025.</canCuPhapLy>
  <rdfs:label xml:lang="vi">khoản 1 Điều 23 LXLVPHC</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#KP_LXLVPHC-D23-K1">
  <rdf:type rdf:resource="#KhungPhat"/>
