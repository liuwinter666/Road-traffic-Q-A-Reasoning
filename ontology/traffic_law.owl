<owl:ObjectProperty rdf:about="#coKhungPhat">
  <rdfs:domain rdf:resource="#DieuKhoan"/>
  <rdfs:range rdf:resource="#KhungPhat"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#thuocDieuKhoanCha"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#coKhungPhat"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label xml:lang="vi">có khung phạt</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#chiuKhungPhat">
  <rdfs:domain rdf:resource="#HanhVi"/>
  <rdfs:range rdf:resource="#KhungPhat"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#apDungDieuKhoan"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#coKhungPhat"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label xml:lang="vi">chịu khung phạt</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#coHinhThucBoSung">
