  <thuocPhienBan rdf:resource="#V1"/>
  <thuocVanBan rdf:resource="#ND100"/>
  <maDieuKhoan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ND100-D16</maDieuKhoan>
  <trichDan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 16 NĐ 100/2019</trichDan>
