  <noiDung rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vi phạm hành chính đối với nhiều người, trẻ em, người già, người khuyết tật, phụ nữ mang thai.</noiDung>
  <trangThai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</trangThai>
