  <maDieuKhoan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LTTATGT-D10-K3</maDieuKhoan>
  <trichDan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">khoản 3 Điều 10 Luật TTATGT 2024</trichDan>
  <noiDung rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Khi chở trẻ em dưới 10 tuổi và chiều cao dưới 1,35 mét trên xe ô tô, người lái xe không được cho trẻ em ngồi cùng hàng ghế, trừ xe ô tô chỉ có một hàng ghế; người lái xe phải sử dụng, hướng dẫn sử dụng thiết bị an toàn phù hợp cho trẻ em, trừ xe ô tô kinh doanh vận tải hành khách.</noiDung>
  <trangThai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</trangThai>
  <hieuLucTu rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-01T00:00:00.000</hieuLucTu>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Khoản 3 Điều 10 của Luật này có hiệu lực thi hành từ ngày 01 tháng 7 năm 2026.</canCuPhapLy>
  <rdfs:label xml:lang="vi">LTTATGT_2026B — khoản 3 Điều 10 Luật TTATGT 2024</rdfs:label>
</owl:NamedIndividual>

