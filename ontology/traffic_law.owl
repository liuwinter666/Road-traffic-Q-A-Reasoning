<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/traffic-law-vn/ontology"
         xmlns="http://www.semanticweb.org/traffic-law-vn/ontology#">

<owl:Ontology rdf:about="http://www.semanticweb.org/traffic-law-vn/ontology">
  <rdfs:comment xml:lang="vi">Ontology hệ chuyên gia tư vấn vi phạm luật giao thông đường bộ. Sinh tự động bởi src/kb/build_ontology.py — không sửa tay; sửa config/*.yaml rồi chạy lại.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#dieuKhien">
  <rdfs:domain rdf:resource="#Nguoi"/>
  <rdfs:range rdf:resource="#PhuongTien"/>
  <rdfs:label xml:lang="vi">điều khiển</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#laChuSoHuu">
