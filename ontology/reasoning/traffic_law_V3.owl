<owl:NamedIndividual rdf:about="#TTGN_1">
  <rdf:type rdf:resource="#TinhTietGiamNhe"/>
  <rdfs:label xml:lang="vi">Người vi phạm hành chính đã có hành vi ngăn chặn, làm giảm bớt hậu quả của vi phạm hoặc tự nguyện khắc phục hậu quả, bồi thường thiệt hại</rdfs:label>
  <rdfs:comment xml:lang="vi">Người vi phạm hành chính đã có hành vi ngăn chặn, làm giảm bớt hậu quả của vi phạm hoặc tự nguyện khắc phục hậu quả, bồi thường thiệt hại;</rdfs:comment>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LXLVPHC:LXLVPHC-D9-K1</canCuPhapLy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#TTGN_2">
  <rdf:type rdf:resource="#TinhTietGiamNhe"/>
  <rdfs:label xml:lang="vi">Người vi phạm hành chính đã tự nguyện khai báo, thành thật hối lỗi; tích cực giúp đỡ cơ quan chức năng phát hiện vi phạm hành chính, xử lý vi phạm hàn</rdfs:label>
  <rdfs:comment xml:lang="vi">Người vi phạm hành chính đã tự nguyện khai báo, thành thật hối lỗi; tích cực giúp đỡ cơ quan chức năng phát hiện vi phạm hành chính, xử lý vi phạm hành chính;</rdfs:comment>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LXLVPHC:LXLVPHC-D9-K2</canCuPhapLy>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#TTGN_3">
  <rdf:type rdf:resource="#TinhTietGiamNhe"/>
  <rdfs:label xml:lang="vi">Vi phạm hành chính trong tình trạng bị kích động về tinh thần do hành vi trái pháp luật của người khác gây ra; vượt quá giới hạn phòng vệ chính đáng; </rdfs:label>
  <rdfs:comment xml:lang="vi">Vi phạm hành chính trong tình trạng bị kích động về tinh thần do hành vi trái pháp luật của người khác gây ra; vượt quá giới hạn phòng vệ chính đáng; vượt quá yêu cầu của tình thế cấp thiết;</rdfs:comment>
  <canCuPhapLy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LXLVPHC:LXLVPHC-D9-K3</canCuPhapLy>
