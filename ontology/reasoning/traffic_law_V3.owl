<owl:NamedIndividual rdf:about="#V3_ND168-D12">
  <rdf:type rdf:resource="#Dieu"/>
  <thuocPhienBan rdf:resource="#V3"/>
  <maDieuKhoan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ND168-D12</maDieuKhoan>
  <trichDan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Điều 12 NĐ 168/2024</trichDan>
  <noiDung rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xử phạt, trừ điểm giấy phép lái xe các hành vi vi phạm khác về quy tắc giao thông đường bộ; sử dụng lòng đường, vỉa hè vào mục đích khác</noiDung>
  <trangThai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</trangThai>
  <hieuLucTu rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-01-01T00:00:00.000</hieuLucTu>
