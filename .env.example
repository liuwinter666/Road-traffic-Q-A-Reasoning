# Sao chép file này thành .env và điền giá trị. KHÔNG commit file .env.

# ---------- LLM ----------
# Provider: gemini (chính — Google Gemini API, gói miễn phí) | ollama (dự phòng, chạy local)
LLM_PROVIDER=gemini
# Lấy key miễn phí: https://aistudio.google.com/apikey (đăng nhập Google → "Create API key")
GEMINI_API_KEY=
# Model Flash/Flash-Lite đang có gói miễn phí; kiểm tra danh sách: python -m scripts.check_llm --list
GEMINI_MODEL=gemini-3.5-flash-lite
# Ollama: cài tại https://ollama.com, rồi `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Máy chỉ có CPU: một lần trích xuất với model 7B mất vài phút; model 3B nhanh gấp ~2 lần
OLLAMA_TIMEOUT_S=300
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=60
# Giới hạn request/phút (đặt thấp hơn hạn mức gói miễn phí của model đang dùng)
LLM_MAX_RPM=10
# Retry khi 429 / lỗi tạm thời: số lần và hệ số backoff (giây)
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_S=2
# Cache phản hồi ra .cache/llm/ (khóa = hash provider + model + prompt)
LLM_CACHE=true

# ---------- Embedding / RAG ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# Ngưỡng cosine tối thiểu để entity linker chấp nhận một node ontology
ENTITY_LINK_THRESHOLD=0.65
# Embedding dự phòng khi từ điển đồng nghĩa không khớp (lần đầu tải model ~2 GB)
ENTITY_LINK_EMBEDDING=true
# faiss | chroma
VECTOR_STORE=faiss

# ---------- Reasoner ----------
# Đường dẫn java.exe (Java 25+ vì owlready2 0.51). Để trống nếu java đã có trong PATH.
JAVA_EXE=
# hermit | pellet  (HermiT mặc định: Pellet 2.3.1 không kích hoạt luật SWRL có lớp ngưỡng — xem src/kb/reasoner.py)
REASONER=hermit
# Bộ nhớ heap cho JVM (MB)
JAVA_MEMORY_MB=2000

# ---------- Pháp lý ----------
# Phiên bản mặc định khi không rõ thời điểm vi phạm: khai ở config/legal_sources.yaml (default_version: current
# = phiên bản đang có hiệu lực hôm nay), không đặt ở đây.

# ---------- Logging ----------
LOG_LEVEL=INFO
