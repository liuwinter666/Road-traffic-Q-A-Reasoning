# Sao chép file này thành .env và điền giá trị. KHÔNG commit file .env.

# ---------- LLM ----------
# Provider: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tùy chọn, chỉ dùng khi LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=60

# ---------- Embedding / RAG ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# Ngưỡng cosine tối thiểu để entity linker chấp nhận một node ontology
ENTITY_LINK_THRESHOLD=0.65
# faiss | chroma
VECTOR_STORE=faiss

# ---------- Reasoner ----------
# Đường dẫn java.exe (Java 25+ vì owlready2 0.51). Để trống nếu java đã có trong PATH.
JAVA_EXE=
# hermit | pellet  (HermiT mặc định: Pellet 2.3.1 không kích hoạt luật SWRL có lớp ngưỡng — xem src/kb/reasoner.py)
REASONER=hermit
# Bộ nhớ heap cho JVM (MB)
JAVA_MEMORY_MB=2000

# ---------- Pháp lý ----------
# Phiên bản mặc định khi không rõ thời điểm vi phạm
DEFAULT_LEGAL_VERSION=V3

# ---------- Logging ----------
LOG_LEVEL=INFO
